generator client {
  provider     = "prisma-client-js"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum UserType {
  INDIVIDUAL // Self-registered, no org
  ORGANIZATION_OWNER // Created an organization
  INVITED_MEMBER // Joined via InviteUser link
  ADMIN
}

enum JoinMethod {
  CREATED // This user founded the org
  INVITE // Joined via InviteUser
  WAITLIST // Joined from waitlist
}

enum LanguageCode {
  unknown // UNKNOWN language
  en // English
  fr // French
  es // Spanish
  pt // Portuguese
  de // German
  it // Italian
  nl // Dutch
  zh_CN // Chinese (Simplified)
  zh_TW // Chinese (Traditional)
  ja // Japanese
  ko // Korean
  hi // Hindi
  sw // Swahili
  yo // Yorùbá
  ig // Igbo
  ha // Hausa
  am // Amharic
}

enum Provider {
  GOOGLE
  FACEBOOK
  APPLE
  OTHER
}

enum FormType {
  ORGANIZATION
  INDIVIDUAL
  INVITED
  ADMIN
}

enum OrgType {
  CHURCH
  SCHOOL
  CLUB
  OTHER
}

enum Plans {
  FREEMIUM_USER
  INVITED_STUDENT_UNLIMITED
  STUDENT_PLUS
  STUDENT_UNLIMITED
  TUTOR_PRO
  TUTOR_ELITE
  CHURCH_STARTER
  CHURCH_GROWTH
  CHURCH_ENTERPRISE
  SCHOOL_STARTER
  SCHOOL_GROWTH
  SCHOOL_ENTERPRISE
  CLUB_STARTER
  CLUB_GROWTH
  CLUB_ENTERPRISE
}

enum PlanDuration {
  FREE_PLAN
  MONTHLY_PLAN
  YEARLY_PLAN
}

enum MemberPlanType {
  ORGANIZATION
  INDIVIDUAL
  INVITED_INDIVIDUAL
}

enum EnrollmentStatus {
  ENROLLED
  IN_PROGRESS
  COMPLETED
  DROPPED
  NOT_ENROLLED
}

enum Tracking {
  FIRST_TIME_TRACKING
  SECOND_TIME_TRACKING
}

enum BadgesEnum {
  CADET_BADGE
  COURSE_COMPLETION_BADGE
  CONSISTENCY_BADGE
  MASTERY_BADGE
  MILESTONES_BADGES
}

enum Levels {
  LEVEL1_SEEKER
  LEVEL2_LEARNER
  LEVEL3_DISCIPLE
  LEVEL4_AMBASSADOR
  LEVEL5_MENTOR
}

enum CertificateType {
  COURSE
  OTHER
}

enum Category {
  PRAYER
  DISCUSSION
  DEVOTION
  BLESSING
  TESTIMONY
  QUESTION
}

enum FeedbackType {
  COURSE
  GROUP
  OTHER
}

// ─────────────────────────────────────────────
// USER
// ─────────────────────────────────────────────

model User {
  id            String        @id @default(cuid())
  firebase_uid  String?       @unique
  first_name    String
  last_name     String
  email_address String        @unique
  paymentCode   String?
  password      String?
  country       String
  state         String
  phone_number  String
  language      String?       @default("unknown")
  languageCode  LanguageCode? @default(unknown)
  role          String        @default("student")
  level         String
  point         Int?
  completed     String        @default("false")
  form_type     FormType?     @default(INDIVIDUAL)

  // ── Replaces the old `invited Boolean` flag ──────────────────────────────
  // Use this to distinguish who a user IS at the identity level:
  //   INDIVIDUAL         → self-registered, no org
  //   ORGANIZATION_OWNER → created an org (Organization.userId = this user)
  //   INVITED_MEMBER     → accepted an InviteUser link
  //   ADMIN              → platform admin
  userType UserType @default(INDIVIDUAL)
  // ─────────────────────────────────────────────────────────────────────────

  user_plan         PricingHistory[]
  createdAt         DateTime         @default(now())
  isOnline          Boolean          @default(false)
  lastActive        DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  user_pic          String?
  provider          String?          @default("OTHER")
  completedCourses  Int?
  completedLessons  Int?
  completedVideo    Int?
  isProfileComplete Boolean?         @default(false)
  isFromWaitList    Boolean?
  resetToken        String?
  resetTokenExpires DateTime?
  isVerified        Boolean          @default(false)
  verifiedAt        DateTime?
  isSuspended       Boolean          @default(false)

  enrollment       Enrollment[]
  post             Post[]
  reply            Reply[]
  quizAttempt      QuizAttempt[]
  likes            Likes[]
  Courses          Course[]
  Group            Group[]
  joinedGroups     JoinedGroup[]
  notification     Notification[]
  message          Message[]
  organization     Organization?
  inviteUser       InviteUser[]
  settings         Settings[]
  achievement      Achievement[]
  badgesAndLevel   BadgesAndLevelEarned[]
  progress         Progress[]
  badges           Badges[]
  userSessions     UserSession[]
  pointHistory     PointHistory[]
  discussions      Discussion[]
  discussionLikes  DiscussionLike[]
  sentMessages     PrivateMessage[]       @relation("SentMessages")
  receivedMessages PrivateMessage[]       @relation("ReceivedMessages")
  feedBack         Feedback[]
  certificate      Certificate[]
  savedCourses     SavedCourses[]
  adminProfile     AdminProfile?
  additionalData   UserAdditionalData?
  waitlists        Waitlist?              @relation(fields: [waitlistId], references: [id])
  waitlistId       String?                @unique

  // ── Org membership audit trail (which orgs this user belongs to & how) ──
  organizationMemberships OrganizationMember[]
  // ─────────────────────────────────────────────────────────────────────────
  eventsCreated    OrganizationEvent[]
  eventAttendances EventAttendee[]

  // ── ShekiAI course-drafting assistant sessions (shared DB, separate service) ──
  courseDraftSessions CourseDraftSession[]
}

// ─────────────────────────────────────────────
// ORGANIZATION MEMBER
// Tracks every user–org relationship with full context:
//   who joined, which org, when, via which method, and which invite.
// ─────────────────────────────────────────────

model OrganizationMember {
  id             String     @id @default(cuid())
  userId         String
  organizationId String
  role           String     @default("member") // e.g. "pastor", "student", "admin"
  joinedVia      JoinMethod @default(INVITE)
  joinedAt       DateTime   @default(now())
  isActive       Boolean    @default(true)

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Link back to the specific invite that brought this user in (nullable for CREATED)
  invite   InviteUser? @relation(fields: [inviteId], references: [id])
  inviteId String?

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@index([userId])
}

// ─────────────────────────────────────────────
// WAITLIST
// ─────────────────────────────────────────────

model Waitlist {
  id        String    @id @default(cuid())
  email     String    @unique
  status    String
  users     User[]
  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt
}

// ─────────────────────────────────────────────
// USER ADDITIONAL DATA
// ─────────────────────────────────────────────

model UserAdditionalData {
  id                String   @id @default(cuid())
  organization_name String?
  organization_role String?
  organization_type String?
  type              String?  @default("INDIVIDUAL")
  userId            String   @unique
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────
// PRICING HISTORY
// ─────────────────────────────────────────────

model PricingHistory {
  id              String         @id @default(uuid())
  type            MemberPlanType
  amountPayed     Int
  planDuration    PlanDuration
  plans           Plans
  user            User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          String?
  organization    Organization?  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId  String?
  planActivatedAt DateTime       @default(now())
  planUpdatedAt   DateTime?
}

// ─────────────────────────────────────────────
// ADMIN PROFILE
// ─────────────────────────────────────────────

model AdminProfile {
  id          String    @id @default(cuid())
  userId      String    @unique
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        String    @default("super_admin")
  permissions Json?
  createdBy   String?
  lastLoginAt DateTime?
  loginCount  Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId])
  @@index([role])
}

// ─────────────────────────────────────────────
// USER SESSION
// ─────────────────────────────────────────────

// ─────────────────────────────────────────────
// USER SESSION
// ─────────────────────────────────────────────

model UserSession {
  id           String   @id @default(cuid())
  userId       String
  deviceId     String   @unique
  deviceType   String
  accessToken  String?
  refreshToken String
  userType     String
  createdAt    DateTime @default(now())
  lastActive   DateTime @updatedAt
  expiresAt    DateTime
  isRevoked    Boolean  @default(false)
  userAgent    String?
  ipAddress    String?

  // ── Added organizationId for org sessions ──
  organizationId String?
  // ────────────────────────────────────────────

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([deviceId])
  @@index([expiresAt])
  @@index([refreshToken])
  @@index([organizationId])
}

// ─────────────────────────────────────────────
// INVITE USER
// ─────────────────────────────────────────────

model InviteUser {
  id             String       @id @default(cuid())
  email          String
  role           String
  code           String
  invited        Boolean      @default(true)
  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String
  sentBy         User         @relation(fields: [sentById], references: [id], onDelete: Cascade)
  sentById       String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime?    @updatedAt
  expiresIn      DateTime

  // ── Back-link to the OrganizationMember created when invite was accepted ─
  members OrganizationMember[]
  // ─────────────────────────────────────────────────────────────────────────
}

// ─────────────────────────────────────────────
// ORGANIZATION
// ─────────────────────────────────────────────

model Organization {
  id                         String               @id @default(uuid())
  user                       User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId                     String?              @unique // The owner/creator; nullable to allow deletion
  organization_name          String
  organization_type          OrgType              @default(OTHER)
  organization_email         String               @unique
  organization_phone_number  String
  organization_country       String
  organization_state         String
  organization_description   String
  organization_role          String
  organization_password      String?
  organization_year          String
  organization_image         String?
  language                   String?
  languageCode               String?
  resetToken                 String?
  resetTokenExpires          DateTime?
  organization_plan          PricingHistory[]
  form_type                  FormType?            @default(ORGANIZATION)
  isOnline                   Boolean?             @default(false)
  lastActive                 DateTime
  isVerified                 Boolean              @default(false)
  verifiedAt                 DateTime?
  verificationOTP            String?
  verificationOTPExpires     DateTime?
  verificationOTPAttempts    Int                  @default(0)
  verificationOTPResendCount Int                  @default(0)
  verificationOTPResendAt    DateTime?
  isSuspended                Boolean              @default(false)
  Church                     Church_Organization?
  school                     School_Organization?
  Club                       Club_Organization?
  course                     Course[]
  quiz                       Quiz[]
  quizAttempt                QuizAttempt[]
  inviteUser                 InviteUser[]
  notification               Notification[]
  enrollment                 Enrollment[]
  feedBacks                  Feedback[]
  certificate                Certificate[]
  createdAt                  DateTime             @default(now())
  updatedAt                  DateTime?
  posts                      Post[]
  settings                   Settings[]
  pointHistory               PointHistory[]

  // ── All members of this org (owners + invited) ───────────────────────────
  members      OrganizationMember[]
  // ─────────────────────────────────────────────────────────────────────────
  events       OrganizationEvent[]
  userSessions UserSession[]
}

// ─────────────────────────────────────────────
// ORG SUB-TYPES
// ─────────────────────────────────────────────

model Church_Organization {
  id                    String       @id @default(uuid())
  church_min_name       String?
  church_ld_pastor      String?
  church_role           String?
  church_address        String?
  church_weekly_service String?
  church_website        String?
  church_logo           String?
  church_email          String?      @unique
  organization          Organization @relation(fields: [organzationId], references: [id], onDelete: Cascade)
  organzationId         String       @unique
  createdAt             DateTime     @default(now())
  updatedAt             DateTime?
}

model School_Organization {
  id                          String       @id @default(uuid())
  school_name                 String?
  school_type                 String?
  school_address              String?
  school_admin_name           String?
  school_role                 String?
  school_email                String?      @unique
  school_website              String?
  school_accreditation_number String?
  school_document             String?
  school_logo                 String?
  organization                Organization @relation(fields: [organzationId], references: [id], onDelete: Cascade)
  organzationId               String       @unique
  createdAt                   DateTime     @default(now())
  updatedAt                   DateTime?
}

model Club_Organization {
  id                     String       @id @default(uuid())
  club_name              String?
  club_type              String?
  club_leader_name       String?
  club_role              String?
  club_meeting_frequency String?
  club_social_link       String?
  club_parent_org        String?
  club_description       String?
  club_document          String?
  club_email             String?
  organization           Organization @relation(fields: [organzationId], references: [id], onDelete: Cascade)
  organzationId          String       @unique
  createdAt              DateTime     @default(now())
  updatedAt              DateTime?
}

// ─────────────────────────────────────────────
// NOTIFICATIONS
// ─────────────────────────────────────────────

model Notification {
  id             String        @id @default(uuid())
  title          String
  message        String
  type           String
  role           String
  to             String
  isRead         Boolean       @default(false)
  user           User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String?
  course         Course?       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId       String?
  group          Group?        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId        String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime?
  achievement    Achievement?  @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  achievementId  String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String?
  post           Post?         @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId         String?
  reply          Reply?        @relation(fields: [replyId], references: [id], onDelete: Cascade)
  replyId        String?

  @@index([to, courseId])
  @@index([to, groupId])
  @@index([to, createdAt])
  @@index([to, isRead])
  @@index([userId])
}

// ─────────────────────────────────────────────
// SETTINGS
// ─────────────────────────────────────────────

model Settings {
  id                       String        @id @default(uuid())
  show_annoucement         Boolean?      @default(true)
  enable_push_notification Boolean?      @default(true)
  course_updates           Boolean?      @default(true)
  event                    Boolean?      @default(true)
  achievement              Boolean?      @default(true)
  daily_reminders          Boolean?      @default(false)
  group_activity           Boolean?      @default(true)
  email_notification       Boolean?      @default(true)
  darkMode                 Boolean?      @default(true)
  user                     User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization             Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId                   String?
  organizationId           String?
  updatedAt                DateTime
  createdAt                DateTime      @default(now())
}

// ─────────────────────────────────────────────
// COURSES
// ─────────────────────────────────────────────

model Course {
  id                       String                 @id @default(cuid())
  course_title             String
  course_short_description String
  course_description       String
  course_level             String
  course_image             String
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt
  enrollment               Enrollment[]
  material                 Material[]
  module                   Module[]
  objectives               Objectives[]
  quiz                     Quiz[]
  quizAttempt              QuizAttempt[]
  post                     Post[]
  createdBy                String
  createdUserId            String
  createdByDetails         User                   @relation(fields: [createdUserId], references: [id], onDelete: Cascade)
  organizationName         String?
  organization             Organization?          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId           String?
  point                    Int?                   @default(0)
  achivement               Achievement[]
  notification             Notification[]
  videosTracked            VideoTracker[]
  badgesAndLevel           BadgesAndLevelEarned[]
  question                 Question[]
  pointHistory             PointHistory[]
  progress                 Progress?              @relation(fields: [progressId], references: [id], onDelete: Cascade)
  progressId               String?
  savedCourses             SavedCourses[]
  certificate              Certificate[]
  savedCoursesId           String?

  // ── ShekiAI course-drafting assistant (shared DB, separate service) ──
  status             String              @default("PUBLISHED") // DRAFT | PUBLISHED
  aiGenerated        Boolean             @default(false)
  pendingMaterials   Json? // AI-drafted material specs awaiting a real document upload
  courseDraftSession CourseDraftSession?
}

// ─────────────────────────────────────────────
// SHEKIAI COURSE-DRAFTING ASSISTANT
// Conversational session state for ShekiAI's AI course-drafting assistant
// (a separate backend service sharing this database). A tutor's draft
// accumulates here across turns; nothing here is a real Course/Module/etc.
// row until ShekiAI's /finalize step explicitly creates one.
// ─────────────────────────────────────────────

model CourseDraftSession {
  id             String               @id @default(cuid())
  tutorId        String
  status         String               @default("ACTIVE") // ACTIVE | AWAITING_APPROVAL | FINALIZED | ABANDONED
  draftJson      Json
  courseId       String?              @unique
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  lastActivityAt DateTime             @default(now())
  tutor          User                 @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  course         Course?              @relation(fields: [courseId], references: [id])
  messages       CourseDraftMessage[]

  @@index([tutorId, status])
}

model CourseDraftMessage {
  id        String             @id @default(cuid())
  sessionId String
  role      String // system | user | assistant | tool
  content   String?
  toolCallId String?
  toolName  String?
  toolArgs  Json?
  audioUrl  String? // set only if this turn originated from voice (not persisted storage)
  createdAt DateTime           @default(now())
  session   CourseDraftSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
}

// ─────────────────────────────────────────────
// ACHIEVEMENT
// ─────────────────────────────────────────────

model Achievement {
  id                String                 @id @default(uuid())
  title             String
  content           String
  point             Int
  totalPoint        Int?
  progressMessage   String?
  badge             Badges[]
  createdAt         DateTime               @default(now())
  updatedAt         DateTime?
  progress          Progress?              @relation(fields: [progressId], references: [id], onDelete: Cascade)
  progressId        String?
  course            Course?                @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId          String?
  group             Group?                 @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId           String?
  notification      Notification[]
  badges_and_levels BadgesAndLevelEarned[]
  user              User?                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId            String?
}

// ─────────────────────────────────────────────
// PROGRESS
// ─────────────────────────────────────────────

model Progress {
  id                String                 @id @default(uuid())
  progressBar       Int
  startedJourney    Boolean                @default(false)
  pointHistory      PointHistory[]
  achivement        Achievement[]
  badges_and_levels BadgesAndLevelEarned[]
  videoTracker      VideoTracker[]
  courses           Course[]
  badges            Badges[]
  quizAttempt       QuizAttempt[]
  joinedGroup       JoinedGroup[]
  user              User?                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId            String?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime?
  lesson            Lesson?                @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  lessonId          String?

  @@unique([userId, lessonId])
}

// ─────────────────────────────────────────────
// VIDEO TRACKER
// ─────────────────────────────────────────────

model VideoTracker {
  id                String         @id @default(uuid())
  videoFinished     Boolean        @default(false)
  videoTrackTime    Int
  basedTimeTracking Tracking
  course            Course?        @relation(references: [id], fields: [courseId], onDelete: Cascade)
  lesson            Lesson?        @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  progress          Progress?      @relation(fields: [progressId], references: [id], onDelete: Cascade)
  progressId        String?
  lessonId          String?
  courseId          String?
  pointHistory      PointHistory[]
  createdAt         DateTime       @default(now())
  updatedAt         DateTime?

  @@unique([lessonId, progressId])
}

// ─────────────────────────────────────────────
// POINT HISTORY
// ─────────────────────────────────────────────

model PointHistory {
  id             String        @id @default(uuid())
  title          String?
  reason         String?
  point          Int
  createdAt      DateTime      @default(now())
  updatedAt      DateTime?
  user           User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String?
  course         Course?       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId       String?
  videoTracker   VideoTracker? @relation(fields: [videoTrackerId], references: [id], onDelete: Cascade)
  videoTrackerId String?
  joinedGroup    JoinedGroup?  @relation(fields: [joinedGroupId], references: [id], onDelete: Cascade)
  joinedGroupId  String?
  enrollment     Enrollment?   @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  enrollmentId   String?
  lesson         Lesson?       @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  lessonId       String?
  quizAttempt    QuizAttempt?  @relation(fields: [quizAttemptId], references: [id], onDelete: Cascade)
  quizAttemptId  String?
  progress       Progress?     @relation(fields: [progressId], references: [id], onDelete: Cascade)
  progressId     String?
}

// ─────────────────────────────────────────────
// BADGES & LEVELS
// ─────────────────────────────────────────────

model BadgesAndLevelEarned {
  id            String       @id @default(uuid())
  progress      Progress?    @relation(fields: [progressId], references: [id], onDelete: Cascade)
  badges        Badges[]
  level         Levels       @default(LEVEL1_SEEKER)
  course        Course?      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user          User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String?
  courseId      String?
  progressId    String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime?
  achievement   Achievement? @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  achievementId String?
}

model Badges {
  id                     String                @id @default(uuid())
  badges                 BadgesEnum            @default(CADET_BADGE)
  badgesAndLevelEarned   BadgesAndLevelEarned? @relation(fields: [badgesAndLevelEarnedId], references: [id], onDelete: Cascade)
  badgesAndLevelEarnedId String?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime?
  achievement            Achievement?          @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  achievementId          String?
  user                   User?                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId                 String?
  progress               Progress?             @relation(fields: [progressId], references: [id], onDelete: Cascade)
  progressId             String?
}

// ─────────────────────────────────────────────
// OTP
// ─────────────────────────────────────────────

model Otp {
  id        String   @id @default(cuid())
  email     String
  code      String
  createdAt DateTime @default(now())
  expiresIn DateTime
}

// ─────────────────────────────────────────────
// MESSAGING
// ─────────────────────────────────────────────

model Message {
  id        String    @id @default(uuid())
  content   String
  toUserId  String
  user      User      @relation(references: [id], fields: [userId], onDelete: Cascade)
  userId    String
  createdAt DateTime  @default(now())
  updatedAt DateTime?
}

model PrivateMessage {
  id         String    @id @default(cuid())
  content    String
  senderId   String
  receiverId String
  replyToId  String?
  isDeleted  Boolean   @default(false)
  isEdited   Boolean   @default(false)
  readAt     DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  sender    User             @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiver  User             @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
  replyTo   PrivateMessage?  @relation("ReplyTo", fields: [replyToId], references: [id], onDelete: Cascade)
  replies   PrivateMessage[] @relation("ReplyTo")
  hiddenFor String[]         @default([])

  @@index([senderId])
  @@index([receiverId])
  @@index([replyToId])
  @@index([createdAt])
  @@index([readAt])
}

// ─────────────────────────────────────────────
// POSTS & REPLIES
// ─────────────────────────────────────────────

model Post {
  id             String         @id @default(cuid())
  title          String
  content        String
  userId         String
  createdAt      DateTime       @default(now())
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  replies        Reply[]        @relation("PostReplies")
  likes          Likes[]
  notification   Notification[]
  courses        Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  organization   Organization?  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  courseId       String
  organizationId String?

  @@map("posts")
}

model Reply {
  id           String         @id @default(cuid())
  content      String
  postId       String?
  userId       String
  parentId     String?
  createdAt    DateTime       @default(now())
  notification Notification[]
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  post         Post?          @relation("PostReplies", fields: [postId], references: [id], onDelete: Cascade)
  parent       Reply?         @relation("ReplyChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children     Reply[]        @relation("ReplyChildren")
  likes        Likes[]

  @@index([parentId])
}

model Likes {
  id        String   @id @default(cuid())
  userId    String
  postId    String?
  replyId   String?
  createdAt DateTime @default(now())

  post  Post?  @relation(fields: [postId], references: [id], onDelete: Cascade)
  reply Reply? @relation(fields: [replyId], references: [id], onDelete: Cascade)
  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@unique([userId, replyId])
}

// ─────────────────────────────────────────────
// GROUPS & EVENTS
// ─────────────────────────────────────────────

model Group {
  id                      String         @id @default(uuid())
  group_title             String
  group_short_description String
  group_description       String
  group_image             String?
  event                   Event[]
  joinedEvent             JoinedEvent[]
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt
  createdBy               User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId                  String?
  member                  JoinedGroup[]
  achievement             Achievement[]
  notification            Notification[]
}

model JoinedGroup {
  id           String         @id @default(uuid())
  isJoined     Boolean        @default(false)
  point        Int?           @default(0)
  joinedAt     DateTime       @default(now())
  student      User?          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  group        Group?         @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId      String
  studentId    String
  pointHistory PointHistory[]
  progress     Progress?      @relation(fields: [progressId], references: [id], onDelete: Cascade)
  progressId   String?

  @@unique([groupId, studentId])
}

model Event {
  id                String        @id @default(ulid())
  event_name        String
  event_description String
  event_time        String
  event_date        String
  event_type        String
  event_link        String
  group             Group         @relation(fields: [groupid], references: [id], onDelete: Cascade)
  joinedEvent       JoinedEvent[]
  groupid           String
  createdAt         DateTime      @default(now())
  updatedAt         DateTime?
}

model JoinedEvent {
  id            String    @id @default(ulid())
  isjoinedEvent Boolean
  createdAt     DateTime  @default(now())
  updatedAt     DateTime?
  group         Group?    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId       String?
  event         Event?    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId       String?
}

// ─────────────────────────────────────────────
// ORGANIZATION EVENTS
// ─────────────────────────────────────────────

model OrganizationEvent {
  id               String       @id @default(cuid())
  name             String
  description      String?
  date             DateTime
  time             String
  location         String?
  capacity         Int          @default(100)
  type             String       @default("general")
  status           String       @default("upcoming") // upcoming, ongoing, past, cancelled
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy        String
  createdByUser    User         @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  attendees        EventAttendee[]
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
}

model EventAttendee {
  id             String           @id @default(cuid())
  eventId        String
  event          OrganizationEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  status         String           @default("registered") // registered, attended, cancelled
  joinedAt       DateTime         @default(now())

  @@unique([eventId, userId])
}

// ─────────────────────────────────────────────
// ENROLLMENT
// ─────────────────────────────────────────────

model Enrollment {
  id             String           @id @default(cuid())
  userId         String
  courseId       String
  score          Int?             @default(0)
  status         EnrollmentStatus @default(NOT_ENROLLED)
  certificate    Certificate[]
  course         Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  enrolledAt     DateTime         @default(now())
  completedAt    DateTime?
  startedAt      DateTime
  createdAt      DateTime         @default(now())
  pointHistory   PointHistory[]
  organization   Organization?    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String?

  @@unique([userId, courseId])
}

// ─────────────────────────────────────────────
// SAVED COURSES
// ─────────────────────────────────────────────

model SavedCourses {
  id        String   @id @default(cuid())
  courses   Course?  @relation(fields: [courseId], references: [id])
  user      User?    @relation(fields: [userId], references: [id])
  userId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  courseId  String?  @unique
}

// ─────────────────────────────────────────────
// MODULE & LESSON
// ─────────────────────────────────────────────

model Module {
  id                 String   @id @default(cuid())
  module_title       String
  module_description String
  module_duration    String
  courseId           String
  order              Int?     @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  lesson             Lesson[]
  course             Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  pendingLessons     Json? // AI-drafted lesson specs awaiting a real video upload (ShekiAI course-drafting assistant)
}

model Lesson {
  id           String         @id @default(cuid())
  lesson_title String?
  lesson_video String
  lessonScore  Int?
  videoTracker VideoTracker[]
  moduleId     String
  order        Int?           @default(0)
  point        Int            @default(0)
  duration     Int?
  pointHistory PointHistory[]
  progress     Progress[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  module       Module         @relation(fields: [moduleId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────
// MATERIAL
// ─────────────────────────────────────────────

model Material {
  id                   String   @id @default(cuid())
  material_title       String?
  material_description String?
  material_pages       Int?
  material_document    String
  courseId             String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  course               Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────
// QUIZ
// ─────────────────────────────────────────────

model Quiz {
  id             String        @id @default(cuid())
  title          String
  description    String?
  course         Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId       String
  point          Int?          @default(0)
  duration       Int?
  passingScore   Int?          @default(70)
  maxAttempts    Int?          @default(3)
  quizProgress   Int?
  questions      Question[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  QuizAttempt    QuizAttempt[]
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String?

  @@map("quizzes")
}

model Question {
  id            String       @id @default(cuid())
  question      String
  options       String[]
  correctAnswer String
  explanation   String?
  points        Int          @default(1)
  order         Int?
  quiz          Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  quizId        String
  quizAttempt   QuizAttempt? @relation(fields: [quizAttemptId], references: [id], onDelete: Cascade)
  quizAttemptId String?
  createdAt     DateTime     @default(now())
  course        Course?      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId      String?

  @@map("questions")
}

model QuizAttempt {
  id             String         @id @default(cuid())
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String
  quiz           Quiz           @relation(fields: [quizId], references: [id], onDelete: Cascade)
  quizId         String
  questions      Question[]
  timeFinished   Int
  score          Int
  answers        Json
  completed      Boolean        @default(false)
  startedAt      DateTime       @default(now())
  completedAt    DateTime?
  course         Course?        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId       String?
  progress       Progress?      @relation(fields: [progressId], references: [id], onDelete: Cascade)
  progressId     String?
  pointHistory   PointHistory[]
  organization   Organization?  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String?

  @@unique([userId, quizId, courseId, organizationId])
  @@map("quiz_attempts")
}

// ─────────────────────────────────────────────
// OBJECTIVES
// ─────────────────────────────────────────────

model Objectives {
  id               String   @id @default(cuid())
  objective_title1 String
  objective_title2 String
  objective_title3 String
  objective_title4 String
  objective_title5 String
  courseId         String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  course           Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────
// CERTIFICATE
// ─────────────────────────────────────────────

model Certificate {
  id                  String          @id @default(cuid())
  certificateType     CertificateType @default(OTHER)
  certificateImageURL String
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  course              Course?         @relation(fields: [courseId], references: [id])
  courseId            String?
  organization        Organization?   @relation(fields: [organizationId], references: [id])
  organizationId      String?
  user                User?           @relation(fields: [userId], references: [id])
  userId              String?
  enrollment          Enrollment?     @relation(fields: [enrollmentId], references: [id])
  enrollmentId        String?
}

// ─────────────────────────────────────────────
// DISCUSSIONS
// ─────────────────────────────────────────────

model Discussion {
  id        String           @id @default(cuid())
  content   String
  category  Category         @default(DISCUSSION)
  mediaUrls Json?            @default("[]")
  isPublic  Boolean          @default(true)
  authorId  String
  parentId  String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  author    User             @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent    Discussion?      @relation("DiscussionReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Discussion[]     @relation("DiscussionReplies")
  likes     DiscussionLike[]

  @@index([authorId])
  @@index([parentId])
  @@index([createdAt])
  @@index([isPublic])
}

model DiscussionLike {
  id           String   @id @default(cuid())
  discussionId String
  userId       String
  createdAt    DateTime @default(now())

  discussion Discussion @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([discussionId, userId])
  @@index([discussionId])
  @@index([userId])
}

// ─────────────────────────────────────────────
// FEEDBACK
// ─────────────────────────────────────────────

model Feedback {
  id             String        @id @default(ulid())
  message        String
  type           FeedbackType
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  user           User?         @relation(fields: [userId], references: [id])
  userId         String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  organizationId String?
}
