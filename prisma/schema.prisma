generator client {
  provider     = "prisma-client-js"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String                 @id @default(cuid())
  firebase_uid      String?                @unique
  first_name        String
  last_name         String
  email_address     String                 @unique
  paymentCode       String?
  password          String?
  country           String
  state             String
  phone_number      String
  role              String                 @default("student")
  level             String
  point             Int?
  completed         String                 @default("false")
  form_type         FormType?              @default(INDIVIDUAL)
  user_plan         PricingHistory[]
  createdAt         DateTime               @default(now())
  isOnline          Boolean                @default(false)
  lastActive        DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  user_pic          String?
  invited           Boolean?               @default(false)
  provider          String?                @default("OTHER")
  completedCourses  Int?
  completedLessons  Int?
  completedVideo    Int?
  isProfileComplete Boolean?               @default(false)
  enrollment        Enrollment[]
  post              Post[]
  reply             Reply[]
  quizAttempt       QuizAttempt[]
  likes             Likes[]
  Courses           Course[]
  Group             Group[]
  joinedGroups      JoinedGroup[]
  notification      Notification[]
  message           Message[]
  organization      Organization[]
  inviteUser        InviteUser[]
  settings          Settings[]
  achievement       Achievement[]
  badgesAndLevel    BadgesAndLevelEarned[]
  progress          Progress[]
  badges            Badges[]
  userSessions      UserSession[]
  pointHistory      PointHistory[]
  discussions       Discussion[]
  discussionLikes   DiscussionLike[]
  sentMessages      PrivateMessage[]       @relation("SentMessages")
  receivedMessages  PrivateMessage[]       @relation("ReceivedMessages")
  feedBack          Feedback[]
  adminProfile      AdminProfile?
}

enum Provider {
  GOOGLE
  FACEBOOK
  APPLE
  OTHER
}

model PricingHistory {
  id              String         @id @default(uuid())
  type            MemberPlanType
  amountPayed     Int
  planDuration    PlanDuration
  plans           Plans
  user            User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          String?
  organization    Organization?  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId  String?
  planActivatedAt DateTime       @default(now())
  planUpdatedAt   DateTime?
}

enum Plans {
  FREEMIUM_USER
  INVITED_STUDENT_UNLIMITED
  STUDENT_PLUS
  STUDENT_UNLIMITED
  TUTOR_PRO
  TUTOR_ELITE
  CHURCH_STARTER
  CHURCH_GROWTH
  CHURCH_ENTERPRISE
  SCHOOL_STARTER
  SCHOOL_GROWTH
  SCHOOL_ENTERPRISE
  CLUB_STARTER
  CLUB_GROWTH
  CLUB_ENTERPRISE
}

enum PlanDuration {
  FREE_PLAN
  MONTHLY_PLAN
  YEARLY_PLAN
}

enum MemberPlanType {
  ORGANIZATION
  INDIVIDUAL
  INVITED_INDIVIDUAL
}

model AdminProfile {
  id          String    @id @default(cuid())
  userId      String    @unique
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        String    @default("super_admin")
  permissions Json?
  createdBy   String?
  lastLoginAt DateTime?
  loginCount  Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId])
  @@index([role])
}

model UserSession {
  id           String   @id @default(cuid())
  userId       String
  deviceId     String   @unique
  deviceType   String
  accessToken  String?
  refreshToken String
  userType     String
  createdAt    DateTime @default(now())
  lastActive   DateTime @updatedAt
  expiresAt    DateTime
  isRevoked    Boolean  @default(false)
  userAgent    String?
  ipAddress    String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([deviceId])
  @@index([expiresAt])
  @@index([refreshToken])
}

enum FormType {
  ORGANIZATION
  INDIVIDUAL
  INVITED
  ADMIN
}

model InviteUser {
  id             String       @id @default(cuid())
  email          String
  role           String
  code           String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  sentBy         User         @relation(fields: [sentById], references: [id], onDelete: Cascade)
  sentById       String
  createdAt      DateTime     @default(now())
  expiresIn      DateTime
}

model Organization {
  id                        String               @id @default(uuid())
  user                      User?                @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization_name         String
  organization_type         OrgType              @default(OTHER)
  organization_email        String               @unique
  organization_phone_number String
  organization_country      String
  organization_state        String
  organization_description  String
  organization_role         String
  organization_password     String?
  organization_year         String
  organization_image        String?
  organization_plan         PricingHistory[]
  form_type                 FormType?            @default(ORGANIZATION)
  isOnline                  Boolean?             @default(false)
  lastActive                DateTime
  Church                    Church_Organization?
  school                    School_Organization?
  Club                      Club_Organization?
  course                    Course[]
  quiz                      Quiz[]
  quizAttempt               QuizAttempt[]
  inviteUser                InviteUser[]
  notification              Notification[]
  enrollment                Enrollment[]
  feedBacks                 Feedback[]
  userId                    String
  createdAt                 DateTime             @default(now())
  updatedAt                 DateTime?
  posts                     Post[]
  settings                  Settings[]
  pointHistory              PointHistory[]
}

model Church_Organization {
  id                    String       @id @default(uuid())
  church_min_name       String?
  church_ld_pastor      String?
  church_role           String?
  church_address        String?
  church_weekly_service String?
  church_website        String?
  church_logo           String?
  church_email          String?      @unique
  organization          Organization @relation(fields: [organzationId], references: [id], onDelete: Cascade)
  organzationId         String       @unique
  createdAt             DateTime     @default(now())
  updatedAt             DateTime?
}

model School_Organization {
  id                          String       @id @default(uuid())
  school_name                 String?
  school_type                 String?
  school_address              String?
  school_admin_name           String?
  school_role                 String?
  school_email                String?      @unique
  school_website              String?
  school_accreditation_number String?
  school_document             String?
  school_logo                 String?
  organization                Organization @relation(fields: [organzationId], references: [id], onDelete: Cascade)
  organzationId               String       @unique
  createdAt                   DateTime     @default(now())
  updatedAt                   DateTime?
}

model Club_Organization {
  id                     String       @id @default(uuid())
  club_name              String?
  club_type              String?
  club_leader_name       String?
  club_role              String?
  club_meeting_frequency String?
  club_social_link       String?
  club_parent_org        String?
  club_description       String?
  club_document          String?
  club_email             String?
  organization           Organization @relation(fields: [organzationId], references: [id], onDelete: Cascade)
  organzationId          String       @unique
  createdAt              DateTime     @default(now())
  updatedAt              DateTime?
}

enum OrgType {
  CHURCH
  SCHOOL
  CLUB
  OTHER
}

model Notification {
  id             String        @id @default(uuid())
  title          String
  message        String
  type           String
  role           String
  to             String
  isRead         Boolean       @default(false)
  user           User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String?
  course         Course?       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId       String?
  group          Group?        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId        String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime?
  achievement    Achievement?  @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  achievementId  String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String?
  post           Post?         @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId         String?
  reply          Reply?        @relation(fields: [replyId], references: [id], onDelete: Cascade)
  replyId        String?

  @@index([to, courseId])
  @@index([to, groupId])
  @@index([to, createdAt])
  @@index([to, isRead])
  @@index([userId])
}

model Settings {
  id                       String        @id @default(uuid())
  enable_push_notification Boolean?      @default(true)
  course_updates           Boolean?      @default(true)
  event                    Boolean?      @default(true)
  achievement              Boolean?      @default(true)
  daily_reminders          Boolean?      @default(false)
  group_activity           Boolean?      @default(true)
  email_notification       Boolean?      @default(true)
  darkMode                 Boolean?      @default(true)
  user                     User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization             Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId                   String?
  organizationId           String?
  updatedAt                DateTime
  createdAt                DateTime      @default(now())
}

model Course {
  id                       String                 @id @default(cuid())
  course_title             String
  course_short_description String
  course_description       String
  course_level             String
  course_image             String
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt
  enrollment               Enrollment[]
  material                 Material[]
  module                   Module[]
  objectives               Objectives[]
  quiz                     Quiz[]
  quizAttempt              QuizAttempt[]
  post                     Post[]
  createdBy                String
  createdUserId            String
  createdByDetails         User                   @relation(fields: [createdUserId], references: [id], onDelete: Cascade)
  organizationName         String?
  organization             Organization?          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId           String?
  saved                    Boolean                @default(false)
  point                    Int?                   @default(0)
  achivement               Achievement[]
  notification             Notification[]
  videosTracked            VideoTracker[]
  badgesAndLevel           BadgesAndLevelEarned[]
  question                 Question[]
  pointHistory             PointHistory[]
  progress                 Progress?              @relation(fields: [progressId], references: [id], onDelete: Cascade)
  progressId               String?
}

model Achievement {
  id                String                 @id @default(uuid())
  title             String
  content           String
  point             Int
  totalPoint        Int?
  progressMessage   String?
  badge             Badges[]
  createdAt         DateTime               @default(now())
  updatedAt         DateTime?
  progress          Progress?              @relation(fields: [progressId], references: [id], onDelete: Cascade)
  progressId        String?
  course            Course?                @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId          String?
  group             Group?                 @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId           String?
  notification      Notification[]
  badges_and_levels BadgesAndLevelEarned[]
  user              User?                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId            String?
}

model Progress {
  id                String                 @id @default(uuid())
  progressBar       Int
  startedJourney    Boolean                @default(false)
  pointHistory      PointHistory[]
  achivement        Achievement[]
  badges_and_levels BadgesAndLevelEarned[]
  videoTracker      VideoTracker[]
  courses           Course[]
  badges            Badges[]
  quizAttempt       QuizAttempt[]
  joinedGroup       JoinedGroup[]
  user              User?                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId            String?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime?
  lesson            Lesson?                @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  lessonId          String?
}

model PointHistory {
  id             String        @id @default(uuid())
  title          String?
  reason         String?
  point          Int
  createdAt      DateTime      @default(now())
  updatedAt      DateTime?
  user           User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String?
  course         Course?       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId       String?
  videoTracker   VideoTracker? @relation(fields: [videoTrackerId], references: [id], onDelete: Cascade)
  videoTrackerId String?
  joinedGroup    JoinedGroup?  @relation(fields: [joinedGroupId], references: [id], onDelete: Cascade)
  joinedGroupId  String?
  enrollment     Enrollment?   @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  enrollmentId   String?
  lesson         Lesson?       @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  lessonId       String?
  quizAttempt    QuizAttempt?  @relation(fields: [quizAttemptId], references: [id], onDelete: Cascade)
  quizAttemptId  String?
  progress       Progress?     @relation(fields: [progressId], references: [id], onDelete: Cascade)
  progressId     String?
}

model VideoTracker {
  id                String         @id @default(uuid())
  videoFinished     Boolean        @default(false)
  videoTrackTime    Int
  basedTimeTracking Tracking
  course            Course?        @relation(references: [id], fields: [courseId], onDelete: Cascade)
  lesson            Lesson?        @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  progress          Progress?      @relation(fields: [progressId], references: [id], onDelete: Cascade)
  progressId        String?
  lessonId          String?
  courseId          String?
  pointHistory      PointHistory[]
  createdAt         DateTime       @default(now())
  updatedAt         DateTime?
}

enum Tracking {
  FIRST_TIME_TRACKING
  SECOND_TIME_TRACKING
}

model BadgesAndLevelEarned {
  id            String       @id @default(uuid())
  progress      Progress?    @relation(fields: [progressId], references: [id], onDelete: Cascade)
  badges        Badges[]
  level         Levels       @default(LEVEL1_SEEKER)
  course        Course?      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user          User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String?
  courseId      String?
  progressId    String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime?
  achievement   Achievement? @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  achievementId String?
}

model Badges {
  id                     String                @id @default(uuid())
  badges                 BadgesEnum            @default(CADET_BADGE)
  badgesAndLevelEarned   BadgesAndLevelEarned? @relation(fields: [badgesAndLevelEarnedId], references: [id], onDelete: Cascade)
  badgesAndLevelEarnedId String?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime?
  achievement            Achievement?          @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  achievementId          String?
  user                   User?                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId                 String?
  progress               Progress?             @relation(fields: [progressId], references: [id], onDelete: Cascade)
  progressId             String?
}

enum BadgesEnum {
  CADET_BADGE
  COURSE_COMPLETION_BADGE
  CONSISTENCY_BADGE
  MASTERY_BADGE
  MILESTONES_BADGES
}

enum Levels {
  LEVEL1_SEEKER
  LEVEL2_LEARNER
  LEVEL3_DISCIPLE
  LEVEL4_AMBASSADOR
  LEVEL5_MENTOR
}

model Otp {
  id        String   @id @default(cuid())
  email     String
  code      String
  createdAt DateTime @default(now())
  expiresIn DateTime
}

model Message {
  id        String    @id @default(uuid())
  content   String
  toUserId  String
  user      User      @relation(references: [id], fields: [userId], onDelete: Cascade)
  userId    String
  createdAt DateTime  @default(now())
  updatedAt DateTime?
}

model Post {
  id             String         @id @default(cuid())
  title          String
  content        String
  userId         String
  createdAt      DateTime       @default(now())
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  replies        Reply[]        @relation("PostReplies")
  likes          Likes[]
  notification   Notification[]
  courses        Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  organization   Organization?  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  courseId       String
  organizationId String?

  @@map("posts")
}

model Reply {
  id           String         @id @default(cuid())
  content      String
  postId       String?
  userId       String
  parentId     String?
  createdAt    DateTime       @default(now())
  notification Notification[]
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  post         Post?          @relation("PostReplies", fields: [postId], references: [id], onDelete: Cascade)
  parent       Reply?         @relation("ReplyChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children     Reply[]        @relation("ReplyChildren")
  likes        Likes[]

  @@index([parentId])
}

model Likes {
  id        String   @id @default(cuid())
  userId    String
  postId    String?
  replyId   String?
  createdAt DateTime @default(now())

  post  Post?  @relation(fields: [postId], references: [id], onDelete: Cascade)
  reply Reply? @relation(fields: [replyId], references: [id], onDelete: Cascade)
  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@unique([userId, replyId])
}

model Group {
  id                      String         @id @default(uuid())
  group_title             String
  group_short_description String
  group_description       String
  group_image             String?
  event                   Event[]
  joinedEvent             JoinedEvent[]
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt
  createdBy               User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId                  String?
  member                  JoinedGroup[]
  achievement             Achievement[]
  notification            Notification[]
}

model JoinedGroup {
  id           String         @id @default(uuid())
  isJoined     Boolean        @default(false)
  point        Int?           @default(0)
  joinedAt     DateTime       @default(now())
  student      User?          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  group        Group?         @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId      String
  studentId    String
  pointHistory PointHistory[]
  progress     Progress?      @relation(fields: [progressId], references: [id], onDelete: Cascade)
  progressId   String?

  @@unique([groupId, studentId])
}

model Event {
  id                String        @id @default(ulid())
  event_name        String
  event_description String
  event_time        String
  event_date        String
  event_type        String
  event_link        String
  group             Group         @relation(fields: [groupid], references: [id], onDelete: Cascade)
  joinedEvent       JoinedEvent[]
  groupid           String
  createdAt         DateTime      @default(now())
  updatedAt         DateTime?
}

model JoinedEvent {
  id            String    @id @default(ulid())
  isjoinedEvent Boolean
  createdAt     DateTime  @default(now())
  updatedAt     DateTime?
  group         Group?    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId       String?
  event         Event?    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId       String?
}

model Enrollment {
  id             String           @id @default(cuid())
  userId         String
  courseId       String
  score          Int?             @default(0)
  status         EnrollmentStatus @default(NOT_ENROLLED)
  course         Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  enrolledAt     DateTime         @default(now())
  completedAt    DateTime?
  startedAt      DateTime
  createdAt      DateTime         @default(now())
  pointHistory   PointHistory[]
  organization   Organization?    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String?

  @@unique([userId, courseId])
}

enum EnrollmentStatus {
  ENROLLED
  IN_PROGRESS
  COMPLETED
  DROPPED
  NOT_ENROLLED
}

model Module {
  id                 String   @id @default(cuid())
  module_title       String
  module_description String
  module_duration    String
  courseId           String
  order              Int?     @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  lesson             Lesson[]
  course             Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model Lesson {
  id           String         @id @default(cuid())
  lesson_title String?
  lesson_video String
  lessonScore  Int?
  videoTracker VideoTracker[]
  moduleId     String
  order        Int?           @default(0)
  point        Int            @default(0)
  duration     Int?
  pointHistory PointHistory[]
  progress     Progress[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  module       Module         @relation(fields: [moduleId], references: [id], onDelete: Cascade)
}

model Material {
  id                   String   @id @default(cuid())
  material_title       String?
  material_description String?
  material_pages       Int?
  material_document    String
  courseId             String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  course               Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model Quiz {
  id             String        @id @default(cuid())
  title          String
  description    String?
  course         Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId       String
  point          Int?          @default(0)
  duration       Int?
  passingScore   Int?          @default(70)
  maxAttempts    Int?          @default(3)
  quizProgress   Int?
  questions      Question[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  QuizAttempt    QuizAttempt[]
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String?

  @@map("quizzes")
}

model Question {
  id            String       @id @default(cuid())
  question      String
  options       String[]
  correctAnswer String
  explanation   String?
  points        Int          @default(1)
  order         Int?
  quiz          Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  quizId        String
  quizAttempt   QuizAttempt? @relation(fields: [quizAttemptId], references: [id], onDelete: Cascade)
  quizAttemptId String?
  createdAt     DateTime     @default(now())
  course        Course?      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId      String?

  @@map("questions")
}

model QuizAttempt {
  id             String         @id @default(cuid())
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String
  quiz           Quiz           @relation(fields: [quizId], references: [id], onDelete: Cascade)
  quizId         String
  questions      Question[]
  timeFinished   Int
  score          Int
  answers        Json
  completed      Boolean        @default(false)
  startedAt      DateTime       @default(now())
  completedAt    DateTime?
  course         Course?        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId       String?
  progress       Progress?      @relation(fields: [progressId], references: [id], onDelete: Cascade)
  progressId     String?
  pointHistory   PointHistory[]
  organization   Organization?  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String?

  @@unique([userId, quizId, courseId, organizationId])
  @@map("quiz_attempts")
}

model Objectives {
  id               String   @id @default(cuid())
  objective_title1 String
  objective_title2 String
  objective_title3 String
  objective_title4 String
  objective_title5 String
  courseId         String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  course           Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model Discussion {
  id        String   @id @default(cuid())
  content   String
  mediaUrls Json?    @default("[]")
  isPublic  Boolean  @default(true)
  authorId  String
  parentId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author  User             @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent  Discussion?      @relation("DiscussionReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies Discussion[]     @relation("DiscussionReplies")
  likes   DiscussionLike[]

  @@index([authorId])
  @@index([parentId])
  @@index([createdAt])
  @@index([isPublic])
}

model DiscussionLike {
  id           String   @id @default(cuid())
  discussionId String
  userId       String
  createdAt    DateTime @default(now())

  discussion Discussion @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([discussionId, userId])
  @@index([discussionId])
  @@index([userId])
}

model PrivateMessage {
  id         String    @id @default(cuid())
  content    String
  senderId   String
  receiverId String
  replyToId  String?
  isDeleted  Boolean   @default(false)
  isEdited   Boolean   @default(false)
  readAt     DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  sender   User             @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User             @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
  replyTo  PrivateMessage?  @relation("ReplyTo", fields: [replyToId], references: [id], onDelete: Cascade)
  replies  PrivateMessage[] @relation("ReplyTo")

  @@index([senderId])
  @@index([receiverId])
  @@index([replyToId])
  @@index([createdAt])
  @@index([readAt])
}

model Feedback {
  id             String        @id @default(ulid())
  message        String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  user           User?         @relation(fields: [userId], references: [id])
  userId         String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  organizationId String?
}
