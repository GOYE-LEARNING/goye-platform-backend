{
  "entryFile": "src/app.ts",
  "noImplicitAdditionalProperties": "throw-on-extras",
  "controllerPathGlobs": [
    "src/controllers/**/*.ts"
  ],
  "spec": {
    "outputDirectory": "src/routes",
    "specVersion": 3,
    "basePath": "/api",
    "securityDefinitions": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  },
  "routes": {
    "routesDir": "src/routes",
    "basePath": "/api",
    "authenticationModule": "./src/auth/authentication.ts",
      "multerOpts": {
      "limits": {
        "fileSize": 500000000, 
        "files": 1
      },
      "fileFilter": null
    }
  }
}