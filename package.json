{
  "name": "goye-backend",
  "version": "1.0.0",
  "description": "GOYE Education Platform API",
  "main": "dist/app.js",
  "scripts": {
    "postinstall": "npx prisma generate",
    "build": "npx tsoa routes && npx tsoa spec && npx tsc --skipLibCheck --noEmitOnError false",
    "start": "node dist/server.js",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "tsoa:routes": "tsoa routes",
    "tsoa:spec": "tsoa spec",
    "prisma:generate": "npx prisma generate",
    "prisma:push": "npx prisma db push",
    "admin:create": "ts-node prisma/create-admin.ts",
    "admin:create:standalone": "ts-node prisma/create-admin-standalone.ts",
    "render-build": "npm install && npm run build"
  },
  "dependencies": {
    "@getbrevo/brevo": "^5.0.4",
    "@prisma/adapter-pg": "^7.2.0",
    "@prisma/client": "^7.8.0",
    "@tsoa/runtime": "^6.6.0",
    "@types/socket.io": "^3.0.1",
    "bcryptjs": "^3.0.2",
    "body-parser": "^2.2.0",
    "cloudinary": "^2.8.0",
    "cookie": "^1.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "crypto-js": "^4.2.0",
    "dotenv": "^17.4.2",
    "express": "^4.19.0",
    "express-rate-limit": "^8.4.0",
    "firebase": "^12.12.1",
    "firebase-admin": "^13.10.0",
    "flutterwave-node-v3": "^1.3.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "nodemailer": "^8.0.7",
    "pg": "^8.16.3",
    "redis": "^5.12.1",
    "resend": "^6.4.2",
    "socket.io": "^4.8.3",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "tsoa": "^6.6.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie": "^0.6.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/crypto-js": "^4.2.2",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^20.19.24",
    "@types/nodemailer": "^7.0.3",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "prisma": "^7.8.0",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.20.6",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
